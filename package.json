{
  "name": "dsh-plugin-discourse",
  "version": "1.0.1",
  "description": "Discourse administration and agent tools for the DeepSeek Harness: 16 tools for reading, posting, moderating, and administering a Discourse forum.",
  "license": "MIT",
  "author": "AkarinLiu",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "discourse",
    "forum",
    "plugin",
    "agent-tools",
    "moderation",
    "chatops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkarinLiu/dsh-plugin-discourse.git"
  },
  "homepage": "https://github.com/AkarinLiu/dsh-plugin-discourse#readme",
  "bugs": {
    "url": "https://github.com/AkarinLiu/dsh-plugin-discourse/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "verify": "node scripts/verify-package.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepack": "node scripts/smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "scripts/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
